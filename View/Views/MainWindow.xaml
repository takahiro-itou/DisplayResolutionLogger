
<Window x:Class="MonitorLogger.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:MonitorLogger"
    Title="MainWindow"
    Height="512" Width="440"
>
  <Window.Icon>
    <Binding
        Source="Resources/MainWindowEmbedded.ico"
        FallbackValue="{x:Null}"
        TargetNullValue="{x:Null}" />
  </Window.Icon>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Bool2Visible" />
  </Window.Resources>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem Header="E_xit" />
      </MenuItem>
      <MenuItem Header="_Run">
        <MenuItem Header="Run _Command"
            Command="{Binding RunModelTaskCommand}"
        />
        <MenuItem Header="Clear Text"
            Command="{Binding ClearTextCommand}"
        />
      </MenuItem>
    </Menu>

    <Grid>
      <ListView Margin="8" x:Name="lvwEvent">
        <ListView.View>
          <GridView>
            <GridViewColumn
              DisplayMemberBinding="{Binding EventDateTime, StringFormat={}{0:yyyy/MM/dd HH:mm:ss.fff}}"
              Header="Date Time"
            />
            <GridViewColumn
              Width="50"
              DisplayMemberBinding="{Binding EventTitle}"
              Header="Title"
            />
          </GridView>
        </ListView.View>
      </ListView>
    </Grid>

  </DockPanel>

</Window>
